# MongoDB (required for main app)
MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/?retryWrites=true
DB_NAME=treereq_dev

# Google Sign-In — must match the OAuth 2.0 *Web* client ID used in the frontend.
# Option A: set here as:
# GOOGLE_CLIENT_ID=123456789-xxx.apps.googleusercontent.com
# Option B: only set in frontend/.env as VITE_GOOGLE_CLIENT_ID=... (backend loads that file too).
# Option C: a file under the repo’s `.env/` folder named `*.env`, e.g. `.env/oauth.env`, containing
# GOOGLE_CLIENT_ID=... or VITE_GOOGLE_CLIENT_ID=...

GOOGLE_CLIENT_ID=
