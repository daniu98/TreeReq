# Vercel / production — set in Project → Settings → Environment Variables

# Google OAuth (required for sign-in)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Option A (recommended): proxy /api to your FastAPI host (same-origin, no CORS issues)
# Used at build time by scripts/prepare-vercel.mjs to write vercel.json rewrites.
BACKEND_URL=https://your-backend.onrender.com

# Option B: call the API directly from the browser (also set CORS_ORIGINS on the backend)
# VITE_API_BASE=https://your-backend.onrender.com
